{
  "name": "ease-home-portal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "tsx watch server/dev.ts",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint . --ignore-pattern dist",
    "api:seed": "tsx server/seed.ts",
    "api:check": "tsc --noEmit",
    "test:community": "tsx --test tests/creator-database.test.ts",
    "test:browser": "playwright test",
    "community:check": "tsx scripts/check-community.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.34.0",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vercel/node": "^5.3.24",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.2.1",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.42.0",
    "vite": "8.2.2"
  },
  "type": "module"
}
