{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/login/user", "destination": "/index.html" },
    { "source": "/login/broker", "destination": "/index.html" },
    { "source": "/login/admin", "destination": "/index.html" },
    { "source": "/portal/user", "destination": "/index.html" },
    { "source": "/portal/broker", "destination": "/index.html" },
    { "source": "/portal/admin", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
